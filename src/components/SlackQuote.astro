---
interface Props {
	name: string;
	initials: string;
	company: string;
	channel: string;
	date: string;
	quote: string;
	size?: 'lg' | 'sm';
}

const { name, initials, company, channel, date, quote, size = 'sm' } = Astro.props;

const isDM = !channel.startsWith('#');
const channelName = isDM ? channel : channel.slice(1);

// Parse as UTC so the displayed day never shifts with the visitor's timezone
const displayDate = new Date(`${date}T00:00:00Z`).toLocaleDateString('en-US', {
	month: 'short',
	day: 'numeric',
	year: 'numeric',
	timeZone: 'UTC',
});

// One avatar tint per company, picked deterministically from the brand-adjacent set
const tints = ['#FF4D6D', '#FF7E5F', '#1A1A1A', '#3b82f6', '#10b981', '#a78bfa', '#f59e0b'];
const hash = [...company].reduce((acc, ch) => (acc * 31 + ch.charCodeAt(0)) >>> 0, 7);
const tint = tints[hash % tints.length];
---

<article class={`sq sq--${size}`} data-company={company}>
	<div class="sq__meta">
		{isDM ? (
			<svg class="sq__meta-icon" width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2.5 3.5h11v7h-6l-3 2.5v-2.5h-2z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
		) : (
			<span class="sq__hash" aria-hidden="true">#</span>
		)}
		<span class="sq__channel">{isDM ? channelName : <><span class="sr-only">#</span>{channelName}</>}</span>
		<span class="sq__dot" aria-hidden="true">·</span>
		<time datetime={date}>{displayDate}</time>
	</div>

	<div class="sq__msg">
		<span class="sq__avatar" style={`--tint: ${tint}`} aria-hidden="true">{initials}</span>
		<div class="sq__content">
			<div class="sq__who">
				<span class="sq__name">{name}</span>
				<span class="sq__company">{company}</span>
			</div>
			<p class="sq__text">{quote}</p>
		</div>
	</div>
</article>

<style>
	.sq {
		background: var(--bg-secondary);
		border: 1px solid rgba(0, 0, 0, 0.08);
		border-radius: 14px;
		padding: 0.85rem 1.1rem 1.05rem;
		break-inside: avoid;
		display: flex;
		flex-direction: column;
		gap: 0.7rem;
		transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
	}
	.sq:hover {
		border-color: rgba(0, 0, 0, 0.14);
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
	}
	.sq[hidden] { display: none; }

	/* Slack-style channel header */
	.sq__meta {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: #888;
		padding-bottom: 0.65rem;
		border-bottom: 1px solid rgba(0, 0, 0, 0.06);
		min-width: 0;
	}
	.sq__hash { color: #aaa; font-weight: 700; }
	.sq__meta-icon { color: #aaa; flex-shrink: 0; }
	.sq__channel {
		color: #555;
		font-weight: 600;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		min-width: 0;
	}
	.sq__dot { color: #bbb; }
	.sq__meta time { white-space: nowrap; flex-shrink: 0; }

	/* Message row */
	.sq__msg {
		display: flex;
		gap: 0.7rem;
		align-items: flex-start;
	}
	.sq__avatar {
		flex-shrink: 0;
		width: 36px;
		height: 36px;
		border-radius: 50%;
		background: var(--tint);
		color: #fff;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-family: var(--font-sans);
		font-weight: 700;
		font-size: 0.78rem;
		letter-spacing: 0.02em;
	}
	.sq__content { min-width: 0; flex: 1; }
	.sq__who {
		display: flex;
		align-items: baseline;
		flex-wrap: wrap;
		gap: 0 0.45rem;
		line-height: 1.3;
		margin-bottom: 0.15rem;
	}
	.sq__name {
		font-weight: 800;
		font-size: 0.92rem;
		color: var(--text-primary);
	}
	.sq__company {
		font-size: 0.8rem;
		color: #888;
	}
	.sq__text {
		font-family: var(--font-sans);
		font-size: 0.95rem;
		line-height: 1.5;
		color: #1d1c1d;
		white-space: pre-wrap;
		overflow-wrap: anywhere;
		margin: 0;
	}

	/* Featured size */
	.sq--lg {
		padding: 1.1rem 1.4rem 1.4rem;
		border-radius: 18px;
		gap: 1rem;
	}
	.sq--lg .sq__meta { font-size: 0.76rem; padding-bottom: 0.85rem; }
	.sq--lg .sq__avatar { width: 44px; height: 44px; font-size: 0.9rem; }
	.sq--lg .sq__msg { gap: 0.9rem; }
	.sq--lg .sq__name { font-size: 1rem; }
	.sq--lg .sq__company { font-size: 0.86rem; }
	.sq--lg .sq__text { font-size: clamp(1.05rem, 1.5vw, 1.2rem); line-height: 1.55; }

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}
</style>
