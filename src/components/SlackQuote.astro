---
interface Props {
	name: string;
	initials: string;
	company: string;
	channel: string;
	date: string;
	quote: string;
	/** sm = wall card, lg = featured card, xl = the single framed spotlight */
	size?: 'sm' | 'lg' | 'xl';
	/** Star rating the client gave in the message itself (only shown when they wrote one) */
	rating?: number;
	/** Industry bucket the wall filter matches on */
	industry?: string;
	/** Rendered hidden until the wall's "Show more" is pressed */
	overflow?: boolean;
}

const {
	name,
	initials,
	company,
	channel,
	date,
	quote,
	size = 'sm',
	rating,
	industry,
	overflow = false,
} = Astro.props;

const isDM = !channel.startsWith('#');
const channelName = isDM ? channel : channel.slice(1);

// Parse as UTC so the displayed day never shifts with the visitor's timezone
const displayDate = new Date(`${date}T00:00:00Z`).toLocaleDateString('en-US', {
	month: 'short',
	day: 'numeric',
	year: 'numeric',
	timeZone: 'UTC',
});

// One avatar tint per company, picked deterministically from the brand-adjacent set
const tints = ['#FF4D6D', '#FF7E5F', '#1A1A1A', '#3b82f6', '#10b981', '#a78bfa', '#f59e0b'];
const hash = [...company].reduce((acc, ch) => (acc * 31 + ch.charCodeAt(0)) >>> 0, 7);
const tint = tints[hash % tints.length];

const stars = rating ? Math.min(Math.max(Math.round(rating), 0), 5) : 0;
---

<article
	class={`sq sq--${size}`}
	data-company={company}
	data-industry={industry}
	data-overflow={overflow ? 'true' : undefined}
	hidden={overflow}
>
	<div class="sq__meta">
		{isDM ? (
			<svg class="sq__meta-icon" width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2.5 3.5h11v7h-6l-3 2.5v-2.5h-2z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
		) : (
			<span class="sq__hash" aria-hidden="true">#</span>
		)}
		<span class="sq__channel">{isDM ? channelName : <><span class="sr-only">#</span>{channelName}</>}</span>
		<span class="sq__dot" aria-hidden="true">·</span>
		<time datetime={date}>{displayDate}</time>
		{size === 'xl' && (
			<span class="sq__pin">
				<svg width="11" height="11" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M9.5 1.5l5 5-2.3.6-2.6 2.6.4 3.3-1.4 1.4L5.7 11.5 2 15.2 1 14.2l3.7-3.7L1.8 7.6l1.4-1.4 3.3.4 2.6-2.6z" fill="currentColor"/></svg>
				Pinned
			</span>
		)}
	</div>

	<div class="sq__msg">
		<span class="sq__avatar" style={`--tint: ${tint}`} aria-hidden="true">{initials}</span>
		<div class="sq__content">
			<div class="sq__who">
				<span class="sq__name">{name}</span>
				<span class="sq__company">{company}</span>
			</div>
			<p class="sq__text">{quote}</p>
			{stars > 0 && (
				<p class="sq__stars" aria-label={`${stars} out of 5 stars, in the client's own words`}>
					{Array.from({ length: 5 }, (_, i) => (
						<svg class={i < stars ? 'sq__star sq__star--on' : 'sq__star'} width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6L2.5 9.4l6.6-.8z" fill="currentColor"/></svg>
					))}
				</p>
			)}
		</div>
	</div>
</article>

<style>
	.sq {
		background: var(--bg-secondary);
		border: 1px solid rgba(0, 0, 0, 0.08);
		border-radius: 14px;
		padding: 0.8rem 1rem 0.95rem;
		break-inside: avoid;
		display: flex;
		flex-direction: column;
		gap: 0.65rem;
		transition: border-color var(--transition-fast), box-shadow var(--transition-fast), transform var(--transition-fast);
	}
	.sq:hover {
		border-color: rgba(0, 0, 0, 0.14);
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
	}
	.sq[hidden] { display: none; }
	.sq:focus-visible {
		outline: 2px solid var(--accent-primary);
		outline-offset: 3px;
	}

	/* Slack-style channel header */
	.sq__meta {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		color: #888;
		padding-bottom: 0.6rem;
		border-bottom: 1px solid rgba(0, 0, 0, 0.06);
		min-width: 0;
	}
	.sq__hash { color: #aaa; font-weight: 700; }
	.sq__meta-icon { color: #aaa; flex-shrink: 0; }
	.sq__channel {
		color: #555;
		font-weight: 600;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		min-width: 0;
	}
	.sq__dot { color: #bbb; }
	.sq__meta time { white-space: nowrap; flex-shrink: 0; }
	.sq__pin {
		margin-left: auto;
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		color: var(--accent-primary);
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		font-size: 0.66rem;
		flex-shrink: 0;
	}

	/* Message row */
	.sq__msg {
		display: flex;
		gap: 0.7rem;
		align-items: flex-start;
	}
	.sq__avatar {
		flex-shrink: 0;
		width: 34px;
		height: 34px;
		border-radius: 50%;
		background: var(--tint);
		color: #fff;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-family: var(--font-sans);
		font-weight: 700;
		font-size: 0.74rem;
		letter-spacing: 0.02em;
	}
	.sq__content { min-width: 0; flex: 1; }
	.sq__who {
		display: flex;
		align-items: baseline;
		flex-wrap: wrap;
		gap: 0 0.45rem;
		line-height: 1.3;
		margin-bottom: 0.15rem;
	}
	.sq__name {
		font-weight: 800;
		font-size: 0.9rem;
		color: var(--text-primary);
	}
	.sq__company {
		font-size: 0.78rem;
		color: #888;
	}
	.sq__text {
		font-family: var(--font-sans);
		font-size: 0.93rem;
		line-height: 1.5;
		color: #1d1c1d;
		white-space: pre-wrap;
		overflow-wrap: anywhere;
		margin: 0;
	}
	.sq__stars {
		display: flex;
		gap: 2px;
		margin: 0.85rem 0 0;
	}
	.sq__star { color: rgba(0, 0, 0, 0.12); }
	.sq__star--on { color: var(--accent-primary); }

	/* Featured size */
	.sq--lg {
		padding: 1.05rem 1.3rem 1.3rem;
		border-radius: 18px;
		gap: 0.9rem;
	}
	.sq--lg .sq__meta { font-size: 0.74rem; padding-bottom: 0.8rem; }
	.sq--lg .sq__avatar { width: 42px; height: 42px; font-size: 0.86rem; }
	.sq--lg .sq__msg { gap: 0.85rem; }
	.sq--lg .sq__name { font-size: 0.98rem; }
	.sq--lg .sq__company { font-size: 0.84rem; }
	.sq--lg .sq__text { font-size: 1.05rem; line-height: 1.55; }

	/* Spotlight: literally framed, echoing the site's offset-shadow buttons */
	.sq--xl {
		padding: 1.4rem 1.75rem 1.75rem;
		border: 2px solid var(--bg-dark);
		border-radius: 22px;
		box-shadow: 8px 8px 0 var(--bg-dark);
		gap: 1.15rem;
	}
	.sq--xl:hover {
		border-color: var(--bg-dark);
		box-shadow: 10px 10px 0 var(--bg-dark);
		transform: translate(-2px, -2px);
	}
	.sq--xl .sq__meta { font-size: 0.76rem; padding-bottom: 0.95rem; border-bottom-color: rgba(0, 0, 0, 0.1); }
	.sq--xl .sq__avatar { width: 52px; height: 52px; font-size: 1rem; }
	.sq--xl .sq__msg { gap: 1.1rem; }
	.sq--xl .sq__name { font-size: 1.1rem; }
	.sq--xl .sq__company { font-size: 0.9rem; }
	.sq--xl .sq__text {
		font-size: clamp(1.15rem, 1.9vw, 1.45rem);
		line-height: 1.5;
		letter-spacing: -0.01em;
	}

	@media (max-width: 720px) {
		.sq--xl {
			padding: 1.1rem 1.1rem 1.35rem;
			border-radius: 18px;
			box-shadow: 5px 5px 0 var(--bg-dark);
		}
		.sq--xl .sq__avatar { width: 42px; height: 42px; font-size: 0.86rem; }
		.sq--xl .sq__msg { gap: 0.8rem; }
		.sq--xl .sq__pin { display: none; }
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}
</style>
