---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
	const caseStudies = await getCollection('caseStudies');
	return caseStudies.map(entry => ({
		params: { slug: entry.slug }, props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const { title, headline, heroH1, problemIntro, mockup, mockupRows, description, roi, info, industry, platform, image, imageFocus, challenges, solutions, results, highlights, clientUrl } = entry.data;

// Rows for the Retool-style inventory mock: use per-study data if provided, else a default set.
const invRows = mockupRows ?? [
	{ product: 'Wave Hoop Earrings',   sku: 'SG-1042', onHand: '128', incoming: '+200', weeks: '9.0',  status: 'ok' },
	{ product: 'Sunburst Pendant',     sku: 'SG-2088', onHand: '12',  incoming: '0',    weeks: '1.2',  status: 'low' },
	{ product: 'Shell Anklet',         sku: 'SG-3471', onHand: '0',   incoming: '+150', weeks: '0.0',  status: 'reorder' },
	{ product: 'Pearl Huggies',        sku: 'SG-5533', onHand: '340', incoming: '+100', weeks: '12.0', status: 'ok' },
	{ product: 'Tidal Chain Bracelet', sku: 'SG-6120', onHand: '54',  incoming: '0',    weeks: '3.4',  status: 'low' },
	{ product: 'Coral Stud Set',       sku: 'SG-7043', onHand: '612', incoming: '+50',  weeks: '18.0', status: 'ok' },
];
const CardTag = clientUrl ? 'a' : 'div';
const cardLinkProps = clientUrl ? { href: clientUrl, target: '_blank', rel: 'noopener' } : {};
---

<Layout title={`AquiferGrowth | ${title} Case Study`} description={description}>
	<Header />
	
	<main class="cs-page">
		<!-- Hero Section -->
		<section class="cs-hero">
			<div class="cs-container">
				<div class="cs-hero-grid">
					<div class="cs-hero-text">
						<h1>{heroH1 ? heroH1 : `${title} ${headline}`}</h1>
						{description.split('\n\n').map(para => (
							<p class="cs-desc">{para}</p>
						))}

						{highlights && highlights.length > 0 && (
							<ul class="cs-highlights">
								{highlights.map(h => (
									<li>
										<span class="cs-check">
											<svg width="20" height="20" viewBox="0 0 20 20" fill="none">
												<rect width="20" height="20" rx="4" fill="#E8364E"/>
												<path d="M6 10l2.5 2.5L14 7.5" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
											</svg>
										</span>
										<span>{h}</span>
									</li>
								))}
							</ul>
						)}
					</div>

					<div class="cs-hero-card">
						<div class="cs-card-inner">
							<!-- Hero image (or branded colour block fallback); whole card links to client site -->
							{image ? (
								<CardTag class={`cs-card-colour cs-card-image cs-colour--${entry.slug} ${clientUrl ? 'cs-card-link' : ''}`} style={`background-image: url(${image}); background-position: ${imageFocus || 'center'}`} {...cardLinkProps}>
									<div class="cs-card-overlay"></div>
									<span class="cs-card-name">{title}</span>
								</CardTag>
							) : (
								<CardTag class={`cs-card-colour cs-colour--${entry.slug} ${clientUrl ? 'cs-card-link' : ''}`} {...cardLinkProps}>
									<svg class="cs-card-blob" viewBox="0 0 400 200" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
										<ellipse cx="320" cy="40" rx="130" ry="90" opacity="0.18"/>
										<ellipse cx="70" cy="170" rx="100" ry="75" opacity="0.13"/>
									</svg>
									<span class="cs-card-name">{title}</span>
								</CardTag>
							)}
							<!-- CMS meta -->
							<div class="cs-card-meta">
								<div class="cs-meta-row">
									<div class="cs-meta-item">
										<span class="cs-meta-label">Industry</span>
										<span class="cs-meta-value">{industry}</span>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Timeline Section -->
		{(challenges || solutions || results) && (
			<section class="cs-timeline">
				<div class="cs-container">
					<div class="cs-timeline-inner">
						<!-- The Problem -->
						{challenges && challenges.length > 0 && (
							<div class="cs-tl-section">
								<div class="cs-tl-marker"></div>
								<div class="cs-tl-content">
									<h2>The Problem</h2>
									<p class="cs-tl-intro">
										{problemIntro ? problemIntro : `Before working with Aquifer Growth, ${title} struggled to keep up with the operational demands of their catalog. Manual processes couldn't scale.`}
									</p>
									{challenges.map(c => (
										<div class="cs-tl-item">
											<h3>{c.title}</h3>
											<p>{c.body}</p>
										</div>
									))}
								</div>
							</div>
						)}

						<!-- The Solution -->
						{solutions && solutions.length > 0 && (
							<div class="cs-tl-section">
								<div class="cs-tl-marker"></div>
								<div class="cs-tl-content">
									<h2>The Solution</h2>
									{solutions.map(s => (
										<div class="cs-tl-item">
											<h3>{s.title}</h3>
											<p>{s.body}</p>
										</div>
									))}
								</div>
							</div>
						)}

						<!-- How it looks (illustrative mockup) -->
						{mockup && (
							<div class="cs-tl-section">
								<div class="cs-tl-marker"></div>
								<div class="cs-tl-content">
									<h2>How it looks</h2>
									<p class="cs-tl-intro">Illustrative. Real data sits behind access controls, but this is the shape of it: {mockup === 'inventory' ? 'inventory, purchase orders, and forecasting in one connected system.' : mockup === 'materials' ? 'planning, inventory, and raw-material forecasting, fully linked to their Shopify storefront.' : 'every SKU received, attributed, tagged, and made searchable in one system.'}</p>

									{mockup === 'catalog' && (
									<div class="cs-mock">
										<!-- Attribution grid -->
										<div class="cs-mock-card cs-mock-card--grid">
											<div class="cs-mock-bar">
												<span class="cs-mock-dots"><i></i><i></i><i></i></span>
												<span class="cs-mock-tab">Catalog · Attribution</span>
											</div>
											<div class="cs-mock-grid">
												<div class="cs-mock-grow cs-mock-grow--head">
													<span>Product</span><span>Brand</span><span>Skin concern</span><span>Key ingredients</span>
												</div>
												<div class="cs-mock-grow">
													<span class="cs-mock-name">Snail Mucin Essence</span>
													<span><span class="cs-chip cs-chip--brand">COSRX</span></span>
													<span><span class="cs-chip">Hydration</span><span class="cs-chip">Barrier</span></span>
													<span><span class="cs-chip cs-chip--ing">Snail Mucin</span><span class="cs-chip cs-chip--ing">Panthenol</span></span>
												</div>
												<div class="cs-mock-grow">
													<span class="cs-mock-name">Heartleaf Soothing Toner</span>
													<span><span class="cs-chip cs-chip--brand">Anua</span></span>
													<span><span class="cs-chip">Redness</span><span class="cs-chip">Sensitivity</span></span>
													<span><span class="cs-chip cs-chip--ing">Heartleaf</span><span class="cs-chip cs-chip--ing">Niacinamide</span></span>
												</div>
												<div class="cs-mock-grow">
													<span class="cs-mock-name">Rice Glow Serum</span>
													<span><span class="cs-chip cs-chip--brand">Beauty of Joseon</span></span>
													<span><span class="cs-chip">Brightening</span><span class="cs-chip">Dullness</span></span>
													<span><span class="cs-chip cs-chip--ing">Rice</span><span class="cs-chip cs-chip--ing">Niacinamide</span></span>
												</div>
												<div class="cs-mock-grow">
													<span class="cs-mock-name">Centella Ampoule</span>
													<span><span class="cs-chip cs-chip--brand">SKIN1004</span></span>
													<span><span class="cs-chip">Barrier Repair</span></span>
													<span><span class="cs-chip cs-chip--ing">Centella</span></span>
												</div>
											</div>
											<div class="cs-mock-foot">14,000+ products &middot; 25 fields each</div>
										</div>

										<div class="cs-mock-col">
											<!-- AI attribution card -->
											<div class="cs-mock-card cs-mock-card--ai">
												<div class="cs-mock-ai-head">
													<span class="cs-mock-ai-badge">AI</span>
													<span>Product Attribution</span>
												</div>
												<div class="cs-mock-ai-name">Heartleaf 77% Soothing Toner</div>
												<div class="cs-mock-ai-rows">
													<div class="cs-mock-ai-row"><span>Category</span><span>Skincare &middot; Toner</span></div>
													<div class="cs-mock-ai-row"><span>Country</span><span>South Korea</span></div>
													<div class="cs-mock-ai-row"><span>Skin concerns</span><span>Redness, Sensitivity</span></div>
													<div class="cs-mock-ai-row"><span>Key ingredients</span><span>Heartleaf, Niacinamide</span></div>
												</div>
												<div class="cs-mock-ai-status"><span class="cs-mock-ai-check">&#10003;</span> Attributed &middot; ready for review</div>
											</div>

											<!-- Merchandising taxonomy -->
											<div class="cs-mock-card cs-mock-card--tax">
												<div class="cs-mock-tax-label">Merchandising taxonomy</div>
												<div class="cs-mock-tax-cloud">
													<span class="cs-chip cs-chip--tag">Brand:COSRX</span>
													<span class="cs-chip cs-chip--tag">COO:Korea</span>
													<span class="cs-chip cs-chip--tag">Concern:Dehydration</span>
													<span class="cs-chip cs-chip--tag">Formulation:Serum</span>
													<span class="cs-chip cs-chip--tag">Badge:Staff Pick</span>
													<span class="cs-chip cs-chip--tag">Area:Face</span>
													<span class="cs-chip cs-chip--tag">Live-Aug</span>
													<span class="cs-chip cs-chip--tag">Bestseller</span>
												</div>
											</div>
										</div>
									</div>
									)}

									{mockup === 'inventory' && (
									<div class="cs-rt">
										<div class="cs-rt-side">
											<div class="cs-rt-logo"><span class="cs-rt-logo-mark"></span>{title}</div>
											<div class="cs-rt-nav">
											<div class="cs-rt-grp">Catalog</div>
											<div class="cs-rt-item">Products</div>
											<div class="cs-rt-item">Collections</div>
											<div class="cs-rt-item">SKUs</div>
											<div class="cs-rt-grp">Inventory</div>
											<div class="cs-rt-item">Purchase Orders</div>
											<div class="cs-rt-item">Stock</div>
											<div class="cs-rt-item">Counts</div>
											<div class="cs-rt-item">Suppliers</div>
											<div class="cs-rt-item is-active">Forecasting</div>
											<div class="cs-rt-grp">Orders</div>
											<div class="cs-rt-grp">Reports</div>
											</div>
										</div>
										<div class="cs-rt-main">
											<div class="cs-rt-head"><span class="cs-rt-title">Inventory Forecasting</span><span class="cs-rt-stat">1,240 SKUs</span></div>
											<div class="cs-rt-filters"><span class="cs-rt-filter">Look back &middot; 8 weeks</span><span class="cs-rt-filter">Reorder QTY</span><span class="cs-rt-filter">Weeks of supply</span></div>
											<div class="cs-rt-table">
												<div class="cs-rt-row cs-rt-row--head"><span>Product</span><span>SKU</span><span>On hand</span><span>Incoming</span><span>Wks supply</span><span>Status</span></div>
												{invRows.map(r => (
												<div class="cs-rt-row"><span class="cs-rt-prod">{r.product}</span><span class="cs-rt-sku">{r.sku}</span><span>{r.onHand}</span><span class={r.incoming !== '0' ? 'cs-rt-inc' : ''}>{r.incoming}</span><span>{r.weeks}</span><span><i class={`cs-rt-dot cs-rt-dot--${r.status}`}></i></span></div>
												))}
											</div>
										</div>
									</div>
									)}
									{mockup === 'materials' && (
									<div class="cs-at">
										<div class="cs-at-side">
											<div class="cs-at-base"><span class="cs-at-base-mark"></span>Claymoo Ops</div>
											<div class="cs-at-tables">
											<div class="cs-at-tbl">Shopify Orders <span class="cs-at-sync">Synced</span></div>
											<div class="cs-at-tbl">Kits</div>
											<div class="cs-at-tbl">Kit Formulas</div>
											<div class="cs-at-tbl">Pigment Recipes</div>
											<div class="cs-at-tbl">Raw Materials</div>
											<div class="cs-at-tbl is-active">Forecast</div>
											<div class="cs-at-tbl">Purchase Orders</div>
											</div>
										</div>
										<div class="cs-at-main">
											<div class="cs-at-head"><span class="cs-at-title">Raw Material Forecast</span><span class="cs-at-shopify"><i></i> Linked to Shopify</span></div>
											<div class="cs-at-table">
												<div class="cs-at-row cs-at-row--head"><span>Material</span><span>On hand</span><span>Used / wk</span><span>Days left</span><span>Status</span></div>
												<div class="cs-at-row"><span class="cs-at-mat"><i class="cs-at-sw" style="background:#eeeeee;border-color:#cccccc"></i>White Clay</span><span>42 kg</span><span>8.5 kg</span><span>34 d</span><span><span class="cs-chip cs-chip--ok">In stock</span></span></div>
												<div class="cs-at-row"><span class="cs-at-mat"><i class="cs-at-sw" style="background:#e8364e;border-color:#e8364e"></i>Red Pigment</span><span>1.2 kg</span><span>0.4 kg</span><span>21 d</span><span><span class="cs-chip cs-chip--ok">In stock</span></span></div>
												<div class="cs-at-row"><span class="cs-at-mat"><i class="cs-at-sw" style="background:#f2c14e;border-color:#f2c14e"></i>Yellow Pigment</span><span>0.3 kg</span><span>0.35 kg</span><span>6 d</span><span><span class="cs-chip cs-chip--reorder">Reorder</span></span></div>
												<div class="cs-at-row"><span class="cs-at-mat"><i class="cs-at-sw" style="background:#2d6cdf;border-color:#2d6cdf"></i>Blue Pigment</span><span>0.8 kg</span><span>0.2 kg</span><span>28 d</span><span><span class="cs-chip cs-chip--ok">In stock</span></span></div>
												<div class="cs-at-row"><span class="cs-at-mat"><i class="cs-at-sw" style="background:#3aa76d;border-color:#3aa76d"></i>Green Pigment</span><span>0.15 kg</span><span>0.18 kg</span><span>5 d</span><span><span class="cs-chip cs-chip--low">Low</span></span></div>
											</div>
											<div class="cs-at-foot">Consumption computed from Shopify sales &times; kit formulas &times; pigment recipes</div>
										</div>
									</div>
									)}
								</div>
							</div>
						)}

						<!-- The Results -->
						{results && (
							<div class="cs-tl-section">
								<div class="cs-tl-marker"></div>
								<div class="cs-tl-content">
									<h2>The Results</h2>
									<p class="cs-tl-results">{results}</p>
								</div>
							</div>
						)}
					</div>
				</div>
			</section>
		)}

	</main>

	<Footer />
</Layout>

<style>
	/* ─── Page ─── */
	.cs-page {
		padding-top: 2rem;
	}
	/* Reset heavy global heading defaults for this page */
	.cs-page h1, .cs-page h2, .cs-page h3 {
		font-family: var(--font-sans);
		text-transform: none;
		letter-spacing: normal;
		line-height: 1.3;
	}
	.cs-container {
		max-width: 1100px;
		margin: 0 auto;
		padding: 0 2rem;
	}

	/* ─── Hero ─── */
	.cs-hero {
		padding: 3rem 0 4rem;
		background: linear-gradient(180deg, #faf9f7 0%, #fff5f5 100%);
	}

	.cs-hero-grid {
		display: grid;
		grid-template-columns: 1fr 380px;
		gap: 3rem;
		align-items: start;
	}

	.cs-hero-text h1 {
		font-size: clamp(1.6rem, 3.5vw, 2.2rem);
		font-weight: 600;
		letter-spacing: -0.02em;
		line-height: 1.3;
		color: #1a1a1a;
		margin-bottom: 1.5rem;
	}

	.cs-desc {
		font-size: 0.9rem;
		line-height: 1.75;
		color: #555;
		margin-bottom: 2rem;
	}

	/* Highlights (checkmark list) */
	.cs-highlights {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}
	.cs-highlights li {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		font-size: 0.88rem;
		font-weight: 400;
		color: #333;
		line-height: 1.4;
	}
	.cs-check {
		flex-shrink: 0;
		display: flex;
		align-items: center;
	}

	/* ─── Info Card ─── */
	.cs-card-inner {
		background: #fff;
		border-radius: 16px;
		overflow: hidden;
		box-shadow: 0 8px 30px rgba(0,0,0,0.06);
		border: 1px solid rgba(0,0,0,0.06);
	}

	/* Branded colour block */
	.cs-card-colour {
		position: relative;
		aspect-ratio: 9 / 4;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
		overflow: hidden;
		background: #1a1a1a;
	}
	/* Per-slug background, distinct cohesive dark tones */
	.cs-colour--spotlightavi { background: #5a3612; }
	.cs-colour--pulsefx      { background: #2d1f5a; }
	.cs-colour--inoki        { background: #1f4d33; }
	.cs-colour--beauty       { background: #5a1a3d; }
	.cs-colour--wellness     { background: #1a4d4a; }
	.cs-colour--fashion      { background: #1f2840; }
	.cs-colour--staygolden   { background: #4a3d0f; }
	.cs-colour--hairstrong   { background: #4a1f2d; }
	.cs-colour--pb           { background: #2d3d1a; }
	.cs-colour--milros       { background: #4d2d0a; }
	.cs-colour--claymoo      { background: #5a2d1a; }
	.cs-colour--stepsciences { background: #1a3d4d; }

	/* Image variant: photo as background with subtle dark gradient overlay */
	.cs-card-image {
		background-size: cover;
		background-position: center;
		background-repeat: no-repeat;
	}
	.cs-card-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, rgba(0,0,0,0.15) 0%, rgba(0,0,0,0.55) 100%);
		pointer-events: none;
	}

	.cs-card-blob {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
	}
	/* Per-slug blob accent tint */
	.cs-card-blob ellipse                              { fill: #ffffff; }
	.cs-colour--spotlightavi .cs-card-blob ellipse     { fill: #fde68a; }
	.cs-colour--pulsefx      .cs-card-blob ellipse     { fill: #c4b5fd; }
	.cs-colour--inoki        .cs-card-blob ellipse     { fill: #a7f3d0; }
	.cs-colour--beauty       .cs-card-blob ellipse     { fill: #fbcfe8; }
	.cs-colour--wellness     .cs-card-blob ellipse     { fill: #99f6e4; }
	.cs-colour--fashion      .cs-card-blob ellipse     { fill: #bfdbfe; }
	.cs-colour--staygolden   .cs-card-blob ellipse     { fill: #fef3c7; }
	.cs-colour--hairstrong   .cs-card-blob ellipse     { fill: #fecaca; }
	.cs-colour--pb           .cs-card-blob ellipse     { fill: #d9f99d; }
	.cs-colour--milros       .cs-card-blob ellipse     { fill: #fcd34d; }
	.cs-colour--claymoo      .cs-card-blob ellipse     { fill: #fed7aa; }
	.cs-colour--stepsciences .cs-card-blob ellipse     { fill: #a5f3fc; }

	.cs-card-name {
		position: relative;
		z-index: 1;
		color: #fff;
		font-family: var(--font-display, 'Inter Tight', sans-serif);
		font-size: 1.4rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		text-transform: uppercase;
		text-align: center;
		padding: 0 1.25rem;
	}
	/* Whole card is a link to the client site */
	.cs-card-link { cursor: pointer; text-decoration: none; }
	.cs-visit-btn {
		position: relative;
		z-index: 1;
		background: rgba(255,255,255,0.18);
		border: 1px solid rgba(255,255,255,0.35);
		color: #fff;
		font-size: 0.75rem;
		font-weight: 600;
		padding: 0.35rem 0.9rem;
		border-radius: 999px;
		text-decoration: none;
		transition: background 0.2s, transform 0.2s;
	}
	.cs-card-link:hover .cs-visit-btn { background: rgba(255,255,255,0.32); transform: translateY(-1px); }

	/* Meta section */
	.cs-card-meta {
		padding: 1.25rem 1.5rem 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
	}
	.cs-meta-item--stat {
		text-align: center;
	}
	.cs-meta-stat {
		display: block;
		font-size: 1.8rem;
		font-weight: 800;
		color: #1a1a1a;
		letter-spacing: -0.03em;
		line-height: 1;
	}
	.cs-meta-divider {
		height: 1px;
		background: #f0f0f0;
	}
	.cs-meta-row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
	}
	.cs-meta-label {
		display: block;
		font-size: 0.68rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		font-weight: 600;
		color: #aaa;
		margin-bottom: 0.2rem;
	}
	.cs-meta-value {
		display: block;
		font-size: 0.9rem;
		font-weight: 700;
		color: #1a1a1a;
