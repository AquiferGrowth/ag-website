---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const allCaseStudies = (await getCollection('caseStudies')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout title="Case Studies | Aquifer Growth" description="See how we've helped brands scale smarter with AI-powered operations.">
	<Header />

	<main class="cs-listing-page">

		<!-- Page Hero -->
		<section class="cs-page-hero">
			<div class="container">
				<div class="badge">Case Studies</div>
				<h1>Work That <span class="text-gradient">Speaks</span></h1>
				<p class="cs-page-sub">Real results from real brands. See how we build, automate, and scale operations that compound.</p>
			</div>
		</section>

		<!-- Grid -->
		<section class="cs-listing-grid-section">
			<div class="container">
				<div class="cs-listing-grid">
					{allCaseStudies.map(cs => (
						<a href={`/case-study/${cs.slug}`} class={`cs-card cs-lc--${cs.slug} ${cs.data.image ? 'cs-card--image' : ''}`}>
							{cs.data.image ? (
								<img src={cs.data.image} alt={cs.data.title} class="cs-card__img" style={`object-position: ${cs.data.imageFocus || 'center'}`} loading="lazy" />
							) : (
								<svg class="cs-lc-blob" viewBox="0 0 400 520" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
									<ellipse cx="330" cy="90" rx="180" ry="140" opacity="0.16"/>
									<ellipse cx="70" cy="430" rx="140" ry="100" opacity="0.11"/>
									<ellipse cx="220" cy="260" rx="90" ry="70" opacity="0.08"/>
								</svg>
							)}
							<div class="cs-card__scrim"></div>
							<div class="cs-card__brand">{cs.data.title}</div>
							<div class="cs-card__foot">
								<span class="cs-card__arrow" aria-hidden="true">
									<svg width="22" height="18" viewBox="0 0 22 18" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M13 1L21 9L13 17M21 9H1" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
								</span>
							</div>
						</a>
					))}
				</div>
			</div>
		</section>

	</main>

	<Footer />
</Layout>

<style>
	.cs-listing-page {
		padding-top: 4rem;
	}

	/* Hero */
	.cs-page-hero {
		text-align: center;
		padding: 4rem 0 3rem;
	}
	.cs-page-hero .badge {
		background: #1A1A1A;
		color: #fff;
		padding: 0.5rem 1.25rem;
		border-radius: 999px;
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		display: inline-block;
		margin-bottom: 1.25rem;
	}
	.cs-page-hero h1 {
		font-size: clamp(2.5rem, 6vw, 4.5rem);
		font-weight: 850;
		letter-spacing: -0.04em;
		line-height: 1.05;
		margin: 0 0 1rem;
	}
	.text-gradient {
		color: #FF4D6D;
	}
	.cs-page-sub {
		font-size: 1.15rem;
		color: #555;
		max-width: 600px;
		margin: 0 auto;
		line-height: 1.6;
	}

	/* Grid */
	.cs-listing-grid-section {
		padding: 3rem 0 6rem;
	}
	.cs-listing-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 2rem;
	}

	/* Card — Platter-style portrait, image-fills, overlaid text */
	.cs-card {
		position: relative;
		display: block;
		aspect-ratio: 1 / 1;
		border-radius: 20px;
		overflow: hidden;
		text-decoration: none;
		color: #fff;
		background: #1a1a1a;
		transition: transform 0.35s ease, box-shadow 0.35s ease;
		isolation: isolate;
	}
	.cs-card:hover {
		transform: translateY(-6px);
		box-shadow: 0 24px 48px rgba(0,0,0,0.14);
	}
	.cs-card__img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		display: block;
	}
	.cs-card__scrim {
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, rgba(0,0,0,0.25) 0%, rgba(0,0,0,0.05) 32%, rgba(0,0,0,0.55) 72%, rgba(0,0,0,0.88) 100%);
		pointer-events: none;
		z-index: 1;
	}
	.cs-card__tag {
		position: absolute;
		top: 1.15rem;
		left: 1.15rem;
		z-index: 3;
		background: rgba(255,255,255,0.18);
		backdrop-filter: blur(6px);
		color: #fff;
		font-family: var(--font-mono, 'IBM Plex Mono', monospace);
		font-size: 0.66rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		padding: 0.35rem 0.85rem;
		border-radius: 999px;
		border: 1px solid rgba(255,255,255,0.28);
	}
	.cs-card__brand {
		position: absolute;
		left: 1.5rem;
		right: 1.5rem;
		top: 50%;
		transform: translateY(-50%);
		z-index: 2;
		font-family: var(--font-display, 'Inter Tight', sans-serif);
		font-weight: 850;
		font-size: clamp(1.9rem, 3.4vw, 2.8rem);
		line-height: 0.95;
		letter-spacing: -0.03em;
		text-transform: uppercase;
		text-align: center;
		color: #fff;
		text-shadow: 0 2px 24px rgba(0,0,0,0.35);
	}
	.cs-card__foot {
		position: absolute;
		left: 0; right: 0; bottom: 0;
		z-index: 3;
		padding: 1.5rem 1.5rem 1.4rem;
		display: flex;
		align-items: flex-end;
		justify-content: flex-end;
		gap: 1rem;
	}
	.cs-card__headline {
		flex: 1;
		margin: 0;
		font-family: var(--font-display, 'Inter Tight', sans-serif);
		font-size: 0.95rem;
		font-weight: 700;
		line-height: 1.3;
		letter-spacing: -0.015em;
		color: #fff;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.cs-card__arrow {
		flex-shrink: 0;
		width: 38px;
		height: 38px;
		border-radius: 999px;
		background: rgba(255,255,255,0.16);
		border: 1px solid rgba(255,255,255,0.3);
		display: inline-flex;
		align-items: center;
		justify-content: center;
		color: #fff;
		transition: background 0.2s ease, transform 0.2s ease;
	}
	.cs-card:hover .cs-card__arrow {
		background: #fff;
		color: #1a1a1a;
		transform: translateX(3px);
	}


	/* Per-slug colours */
	/* Per-slug background, distinct cohesive dark tones */
	.cs-lc--spotlightavi { background: #5a3612; }
	.cs-lc--pulsefx      { background: #2d1f5a; }
	.cs-lc--inoki        { background: #1f4d33; }
	.cs-lc--beauty       { background: #5a1a3d; }
	.cs-lc--wellness     { background: #1a4d4a; }
	.cs-lc--fashion      { background: #1f2840; }
	.cs-lc--staygolden   { background: #4a3d0f; }
	.cs-lc--hairstrong   { background: #4a1f2d; }
	.cs-lc--pb           { background: #2d3d1a; }
	.cs-lc--milros       { background: #4d2d0a; }
	.cs-lc--claymoo      { background: #5a2d1a; }
	.cs-lc--stepsciences { background: #1a3d4d; }

	/* Blob tints per slug */
	/* Per-slug blob accent tint */
	.cs-lc-blob ellipse                            { fill: #ffffff; }
	.cs-lc--spotlightavi .cs-lc-blob ellipse       { fill: #fde68a; }
	.cs-lc--pulsefx      .cs-lc-blob ellipse       { fill: #c4b5fd; }
	.cs-lc--inoki        .cs-lc-blob ellipse       { fill: #a7f3d0; }
	.cs-lc--beauty       .cs-lc-blob ellipse       { fill: #fbcfe8; }
	.cs-lc--wellness     .cs-lc-blob ellipse       { fill: #99f6e4; }
	.cs-lc--fashion      .cs-lc-blob ellipse       { fill: #bfdbfe; }
	.cs-lc--staygolden   .cs-lc-blob ellipse       { fill: #fef3c7; }
	.cs-lc--hairstrong   .cs-lc-blob ellipse       { fill: #fecaca; }
	.cs-lc--pb           .cs-lc-blob ellipse       { fill: #d9f99d; }
	.cs-lc--milros       .cs-lc-blob ellipse       { fill: #fcd34d; }
	.cs-lc--claymoo      .cs-lc-blob ellipse       { fill: #fed7aa; }
	.cs-lc--stepsciences .cs-lc-blob ellipse       { fill: #a5f3fc; }

	.cs-lc-blob {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
	}

	.cs-lc-title {
		position: relative;
		z-index: 1;
		color: #fff;
		font-family: var(--font-display, 'Inter Tight', sans-serif);
		font-size: 1.4rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		text-transform: uppercase;
		text-align: center;
		padding: 0 1.25rem;
	}


	/* Responsive */
	@media (max-width: 1024px) {
		.cs-listing-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (max-width: 640px) {
		.cs-listing-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
